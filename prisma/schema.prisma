// GIGO V1 - Production Database Schema
// 
// Multi-tenant SaaS schema with user authentication,
// adapter configurations, destination forwarding, and audit logs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime: pooled connection. On serverless (Vercel) this MUST be the
  // transaction-mode pooler (port 6543) with `?pgbouncer=true&connection_limit=1`
  // — session mode (5432) holds one Postgres connection per lambda and
  // exhausts the pool ("max clients reached in session mode").
  url = env("DATABASE_URL")
  // Migrations: a connection that supports advisory locks (session mode
  // pooler on 5432, or a direct connection). Only used by the Prisma CLI.
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// USER MODEL
// =============================================================================

/// User profile synchronized with Supabase Auth.
/// Stores additional user metadata and preferences.
model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  adapters Adapter[]
  apiKeys  UserApiKey[]

  @@map("users")
}

/// Per-user LLM provider API key (bring your own key). The platform
/// operator never has to configure provider keys: each user stores their
/// own, encrypted with AES-256-GCM. Env vars remain a fallback for
/// self-hosted single-operator installs.
model UserApiKey {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  provider     String // "openai", "anthropic"
  encryptedKey String   @map("encrypted_key")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("user_api_keys")
}

// =============================================================================
// ADAPTER MODEL
// =============================================================================

/// Adapter represents a unique transformation endpoint configuration.
/// Each adapter defines a target schema and optional destination for forwarding.
model Adapter {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  name        String
  description String?

  // Schema Configuration
  targetSchema       String  @map("target_schema") // JSON string of expected output
  /// Representative "dirty" input for this adapter. Pre-fills the
  /// playground so trying the adapter needs no hand-written payload.
  samplePayload      String? @map("sample_payload")
  schemaSourceType   String? @map("schema_source_type") // "manual", "documentation", "url"
  schemaSourceUrl    String? @map("schema_source_url") // Original doc URL if applicable

  /// Format written back to the caller and forwarded to the destination.
  /// The engine always reasons in JSON; this only changes the edges.
  /// "json" | "xml" | "csv". Input format is detected per request.
  outputFormat       String  @default("json") @map("output_format")
  /// Optional deterministic mapping. When set and enabled, the run skips the
  /// model entirely: no token, no latency, identical output every time.
  /// The expression is written by the model once, then verified on a sample.
  jsonataExpression  String? @map("jsonata_expression")
  jsonataEnabled     Boolean @default(false) @map("jsonata_enabled")

  // AI Model Configuration
  modelProvider String  @default("openai") @map("model_provider") // "openai", "anthropic"
  modelName     String? @map("model_name") // null => provider default

  // Destination Configuration (Forwarding)
  destinationUrl     String? @map("destination_url") // Where to POST transformed data
  destinationMethod  String  @default("POST") @map("destination_method") // HTTP method
  authMethod         String  @default("none") @map("auth_method") // "none", "bearer", "api_key", "basic"
  authHeaderName     String? @map("auth_header_name") // Custom header name (e.g., "X-API-Key")
  encryptedAuthValue String? @map("encrypted_auth_value") // Encrypted token/key
  forwardTimeoutMs   Int     @default(15000) @map("forward_timeout_ms")

  // Security
  webhookSecret   String? @map("webhook_secret") // if set, POST requires matching X-Webhook-Secret
  rateLimitPerMin Int     @default(60) @map("rate_limit_per_min")
  // Email ingress is opt-in: null = disabled; the token travels in the
  // plus-address (inbox+<id>.<token>@...) so a leaked adapter UUID is not
  // enough to inject data by email.
  emailIngestToken String? @map("email_ingest_token")

  // Settings
  isActive        Boolean @default(true) @map("is_active")
  learningEnabled Boolean @default(true) @map("learning_enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs      TransformationLog[]
  learnings AdapterLearning[]

  @@index([userId])
  @@index([createdAt])
  @@map("adapters")
}

/// Learning loop: curated knowledge captured from past runs and injected
/// into the system prompt of subsequent calls (few-shot). Two kinds:
/// - "example": a validated input→output pair (successful replay of a
///   previously failed run, or a log the user saved manually)
/// - "pitfall": a constraint learned from a bad run (e.g. keys the model
///   hallucinated outside the target schema)
model AdapterLearning {
  id          String   @id @default(uuid()) @db.Uuid
  adapterId   String   @map("adapter_id") @db.Uuid
  kind        String // "example" | "pitfall"
  inputJson   String?  @map("input_json")
  outputJson  String?  @map("output_json")
  note        String?
  source      String   @default("auto") // "auto" | "manual" | "replay"
  contentHash String   @map("content_hash") // dedupe key
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  adapter Adapter @relation(fields: [adapterId], references: [id], onDelete: Cascade)

  @@unique([adapterId, contentHash])
  @@index([adapterId, kind])
  @@map("adapter_learnings")
}

// =============================================================================
// TRANSFORMATION LOG MODEL
// =============================================================================

/// TransformationLog records each webhook invocation for debugging and analytics.
/// Stores input, output, and forwarding results.
model TransformationLog {
  id        String  @id @default(uuid()) @db.Uuid
  adapterId String  @map("adapter_id") @db.Uuid

  // Transformation Data
  inputJson  String  @map("input_json") // Original JSON payload
  outputJson String? @map("output_json") // Transformed JSON
  success    Boolean @default(false)
  error      String?

  // Forwarding Results
  forwardedAt        DateTime? @map("forwarded_at")
  forwardingSuccess  Boolean?  @map("forwarding_success")
  forwardingResponse String?   @map("forwarding_response") // Response from destination
  forwardingStatus   Int?      @map("forwarding_status") // HTTP status code

  // Performance Metrics
  transformDuration Int? @map("transform_duration") // Transformation time in ms
  forwardDuration   Int? @map("forward_duration") // Forwarding time in ms
  totalDuration     Int? @map("total_duration") // Total processing time in ms

  // AI Usage
  provider     String? // "openai", "anthropic"
  modelName    String? @map("model_name")
  inputTokens  Int?    @map("input_tokens")
  outputTokens Int?    @map("output_tokens")

  // Origin
  isTest     Boolean @default(false) @map("is_test") // playground run
  replayOfId String? @map("replay_of_id") @db.Uuid

  // Metadata
  sourceIp  String?  @map("source_ip")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  adapter  Adapter             @relation(fields: [adapterId], references: [id], onDelete: Cascade)
  replayOf TransformationLog?  @relation("Replays", fields: [replayOfId], references: [id], onDelete: SetNull)
  replays  TransformationLog[] @relation("Replays")

  @@index([adapterId])
  @@index([adapterId, createdAt])
  @@index([createdAt])
  @@index([success])
  @@index([replayOfId])
  @@map("transformation_logs")
}

// =============================================================================
// RATE LIMITING
// =============================================================================

/// Fixed-window rate limit counters, one row per adapter per minute.
/// id = "<adapterId>:<epochMinute>"; expired rows are lazily deleted.
model RateLimitWindow {
  id        String   @id
  count     Int      @default(1)
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("rate_limit_windows")
}

// =============================================================================
// USAGE TRACKING (For future billing)
// =============================================================================

/// Monthly usage tracking per user for billing and quotas.
model UsageRecord {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // Period
  year  Int
  month Int

  // Counters
  transformationCount Int @default(0) @map("transformation_count")
  forwardingCount     Int @default(0) @map("forwarding_count")
  tokensUsed          Int @default(0) @map("tokens_used")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, year, month])
  @@index([userId])
  @@map("usage_records")
}
