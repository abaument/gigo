# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database — TWO urls, and the difference matters on serverless.
#
# DATABASE_URL = the connection the app uses at runtime. On Vercel/Lambda it
# MUST be the Supabase *transaction mode* pooler (port 6543) with
# `?pgbouncer=true&connection_limit=1`. Session mode (5432) keeps one Postgres
# connection per function instance and quickly fails with
# "max clients reached in session mode - pool_size: 15".
#   postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# DIRECT_URL = used by the Prisma CLI for migrations only (needs advisory
# locks, which transaction pooling does not support): session-mode pooler
# (5432) or a direct db.<ref>.supabase.co connection.
#
# Self-hosting with the bundled Postgres? Set both to the same value:
#   postgresql://gigo:gigo@db:5432/gigo
DATABASE_URL=
DIRECT_URL=

# AI providers — OPTIONAL server-level fallback keys.
# Each user brings their own keys in Settings (encrypted at rest); these
# env vars only serve as a fallback for single-operator self-hosted
# installs. A user's own key always takes precedence.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Encryption — REQUIRED, min 16 chars. The app refuses to start without it.
# Used to encrypt destination credentials (AES-256-GCM).
ENCRYPTION_KEY=

# Base URL of the deployed app (used to build webhook URLs)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: monthly token budget per user (0 or unset = unlimited).
# Set this on shared/demo deployments so one user can't drain AI credits.
MONTHLY_TOKEN_QUOTA=0

# Optional: playground runs allowed per account per minute (default 120).
# The real spend guard is MONTHLY_TOKEN_QUOTA; this only stops a loop.
# Note that failed runs count too, so keep it comfortable when rehearsing.
PLAYGROUND_TESTS_PER_MINUTE=120

# Optional: inbound email (send/forward an email → transformed like a webhook).
# Point your inbound provider's webhook (Postmark format) to
#   POST /api/email/inbound?secret=<EMAIL_INBOUND_SECRET>
# and set the inbox address below (shown on adapter pages with +<adapterId>).
# Both unset = feature disabled.
EMAIL_INBOUND_SECRET=
NEXT_PUBLIC_EMAIL_INBOUND_ADDRESS=
