# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Supabase PostgreSQL connection string)
DATABASE_URL=

# AI providers — at least one is required.
# Each adapter picks its provider (openai | anthropic).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Encryption — REQUIRED, min 16 chars. The app refuses to start without it.
# Used to encrypt destination credentials (AES-256-GCM).
ENCRYPTION_KEY=

# Base URL of the deployed app (used to build webhook URLs)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: monthly token budget per user (0 or unset = unlimited).
# Set this on shared/demo deployments so one user can't drain AI credits.
MONTHLY_TOKEN_QUOTA=0
